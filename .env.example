# Copy to .env and fill in. Never commit .env.

# Stripe Sandbox API Keys
# NOTE: Only TEST mode keys are accepted. Live keys (sk_live_...) are strictly refused.

# 1. Stripe Test Secret Key (Writer: creates test payments & refunds)
# Must start with "sk_test_"
STRIPE_TEST_SECRET_KEY=

# 2. Stripe Test Restricted / Read-Only Key (Reader: verifies refunds)
# Must start with "rk_test_" and have Read permission on Refunds
STRIPE_TEST_READ_ONLY_KEY=

# Optional: webhook alert signing key. Must differ from READBACK_LOG_KEY:
# the alert receiver holds this one, and must never be able to rewrite the log.
# READBACK_ALERT_KEY=

# Evidence-log HMAC key, e.g. python -c "import secrets; print(secrets.token_hex(32))"
READBACK_LOG_KEY=

# Receipt signing key (32+ bytes, must differ from READBACK_LOG_KEY and READBACK_ALERT_KEY)
# READBACK_RECEIPT_KEY=

# readback reconcile: Stripe restricted read-only key (rk_..., refunds: read) and optional FHIR bearer token
# READBACK_STRIPE_KEY=
# READBACK_FHIR_TOKEN=

# Anthropic API key for real-model eval
ANTHROPIC_API_KEY=

# OpenAI API key for real-model eval
OPENAI_API_KEY=
